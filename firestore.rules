rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isMemberOfOrg(orgId) {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/organizationMembers/$(orgId + '_' + request.auth.uid)) ||
        isAdmin()
      );
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && (
        getUserData().role == 'ROLE_ADMIN' || 
        getUserData().role == 'admin' ||
        request.auth.token.admin == true
      );
    }

    function isManager() {
      return isAuthenticated() && (
        getUserData().role == 'ROLE_MANAGER' || 
        getUserData().role == 'team_leader' || 
        getUserData().role == 'manager'
      );
    }

    // Rules for 'users' collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (request.auth.uid == userId || isAdmin() || isManager());
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin() || isManager() || request.auth.token.admin == true);
      allow delete: if isAuthenticated() && (isAdmin() || request.auth.token.admin == true);
    }

    // Rules for 'organizations' collection
    match /organizations/{orgId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // Rules for 'organizationMembers' collection
    match /organizationMembers/{memberDocId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.userEmail == request.auth.token.email ||
        isAdmin() ||
        isManager()
      );
      allow create, update, delete: if isAdmin() || isManager();
    }

    // Rules for 'invitations' collection
    match /invitations/{invitationId} {
      allow read: if isAuthenticated() && (
        resource.data.email == request.auth.token.email ||
        isAdmin() ||
        isManager()
      );
      allow create, update, delete: if isAuthenticated() && (isAdmin() || isManager());
    }

    // Rules for 'projects' collection
    match /projects/{projectId} {
      allow read: if isAuthenticated() && resource.data.organizationId != null && isMemberOfOrg(resource.data.organizationId);
      allow create: if isAuthenticated() && request.resource.data.organizationId != null && isMemberOfOrg(request.resource.data.organizationId) && (isAdmin() || isManager());
      allow update, delete: if isAuthenticated() && resource.data.organizationId != null && isMemberOfOrg(resource.data.organizationId) && (isAdmin() || isManager());
    }

    // Rules for 'tasks' collection
    match /tasks/{taskId} {
      allow read: if isAuthenticated() && resource.data.organizationId != null && isMemberOfOrg(resource.data.organizationId);
      allow create: if isAuthenticated() && request.resource.data.organizationId != null && isMemberOfOrg(request.resource.data.organizationId);
      allow update: if isAuthenticated() && resource.data.organizationId != null && isMemberOfOrg(resource.data.organizationId);
      allow delete: if isAuthenticated() && resource.data.organizationId != null && isMemberOfOrg(resource.data.organizationId) && (isAdmin() || isManager());
    }

    // Rules for 'teams' collection
    match /teams/{teamId} {
      allow read: if isAuthenticated() && (resource.data.organizationId == null || isMemberOfOrg(resource.data.organizationId));
      allow create, update, delete: if isAuthenticated() && (isAdmin() || isManager());
    }

    // Rules for 'notifications' collection
    match /notifications/{notifId} {
      allow read, update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.recipientId == request.auth.uid);
      allow create: if isAuthenticated();
    }

    // Rules for 'audit_logs' collection
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
    }
  }
}

